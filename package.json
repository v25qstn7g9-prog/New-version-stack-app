{
  "name": "stock-app",
  "version": "2.29.1",
  "description": "個人存股資產追蹤 App - 專用投資顧問助手（Cloudflare Workers + Gemini Backup）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "vite build",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "deploy:backup": "cd fallback-vercel && vercel --prod && cd ..",
    "check:version": "node scripts/check-versions.js",
    "test": "vitest run",
    "lint": "eslint src",
    "kv:list": "wrangler kv:namespace list",
    "kv:create": "wrangler kv:namespace create health_kv",
    "kv:delete": "wrangler kv:namespace delete health_kv"
  },
  "keywords": [
    "stock",
    "portfolio",
    "台股",
    "存股",
    "cloudflare-workers",
    "vercel",
    "gemini-ai"
  ],
  "author": "Johnny",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  }
}
