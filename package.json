{
  "name": "stock-app",
  "version": "2.47.25",
  "description": "個人存股資產追蹤 App - 專用投資顧問助手（Cloudflare Workers + Gemini Backup）",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:backup": "cd fallback-vercel && vercel --prod && cd ..",
    "sync:fallback": "node scripts/sync-fallback.mjs",
    "check:version": "node scripts/check-versions.js",
    "kv:list": "wrangler kv:namespace list",
    "kv:create": "wrangler kv:namespace create health_kv",
    "kv:delete": "wrangler kv:namespace delete health_kv",
    "build:app": "node scripts/build-app.mjs",
    "build:css": "tailwindcss -c scripts/tailwind.config.cjs -i scripts/tw-input.css -o tw.css --minify"
  },
  "keywords": [
    "stock",
    "portfolio",
    "台股",
    "存股",
    "cloudflare-workers",
    "vercel",
    "gemini-ai"
  ],
  "author": "Johnny",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/standalone": "7.25.6",
    "lucide-react": "0.344.0",
    "tailwindcss": "3.4.17",
    "terser": "5.31.6"
  }
}
