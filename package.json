{
  "name": "stock-app",
  "version": "2.40.1",
  "description": "個人存股資產追蹤 App - 專用投資顧問助手（Cloudflare Workers + Gemini Backup）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:backup": "cd fallback-vercel && vercel --prod && cd ..",
    "check:version": "node scripts/check-versions.js",
    "kv:list": "wrangler kv:namespace list",
    "kv:create": "wrangler kv:namespace create health_kv",
    "kv:delete": "wrangler kv:namespace delete health_kv"
  },
  "keywords": [
    "stock",
    "portfolio",
    "台股",
    "存股",
    "cloudflare-workers",
    "vercel",
    "gemini-ai"
  ],
  "author": "Johnny",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {},
  "dependencies": {}
}
