{
  "name": "new-version-stack-app",

  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // 健康檢查卡片存放處。id 是你在 Cloudflare Dashboard 建立 health_kv 命名空間
  // 拿到的真正 ID；binding 名稱設成 health_kv（小寫），因為 Dashboard 手動接
  // 這個 KV 的時候把變數名稱自動同步成命名空間本身的名字了，這裡配合它，
  // 不用再回去 Dashboard 改——functions/health-check.js 讀的是 env.health_kv。
  "kv_namespaces": [
    { "binding": "health_kv", "id": "dac5ef4cc5414ad982cb1c135c8abe39" }
  ],
  // 每 30 分鐘自動跑一次健康檢查（背景執行，呼叫 worker.js 的 scheduled()）。
  // cron 語法是 UTC 時間，跟台灣時間無關——只是「每 30 分鐘」這種間隔本身不受時區影響。
  // 想改頻率就改這個字串，例如 "0 * * * *" 是每小時一次。
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
