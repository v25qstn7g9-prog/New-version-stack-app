# ============================================
# 存股 App - Cloudflare Workers 環境變數
# ============================================
# 複製這個檔案成 .env.local，填入你的實際值
# 不要把真實的 API key 上傳到 GitHub！
# ============================================

# 必要：AI binding 已在 wrangler.jsonc 設定
# (不用在這裡設，直接在 Cloudflare Dashboard 啟用 AI binding)

# 選用：公開網路搜尋
# 從 https://tavily.com 申請免費 API key
TAVILY_API_KEY=your_tavily_api_key_here

# 選用：速率限制
# 格式："{max_requests}:{window_seconds}"
ASK_RATE_LIMITER=100:1800

# 選用：Vercel 備援 URL
FALLBACK_URL=https://your-vercel-backup.vercel.app/api/ask

